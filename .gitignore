# environments / caches
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# research-phase leftovers (canonical copy lives in docs/research/)
/docs_research/
/docs_research.zip
/00_RESEARCH_INDEX.md
/12_PROJECT_STRUCTURE.md

# read-only reference clones (consultation only, never imported by src/vox)
/_refs/

# model weights and other large binaries
*.pth
*.pt
*.bin
*.index
*.onnx
*.safetensors
models/*/
!models/README.md

# audio + benchmark artefacts
benchmarks/corpus/*.wav
benchmarks/corpus/*.flac
benchmarks/results/
# out/ is scratch, except the committed TTS acceptance wavs (docs/TTS_NOTES.md)
out/*
!out/expressive/
out/expressive/*
!out/expressive/*.wav
!out/expressive/mae/
out/expressive/mae/*
!out/expressive/mae/*.wav
!out/tts_natural/
out/tts_natural/*
!out/tts_natural/*.wav

# GUI session state (what the user changed in the window) and exported reports
profiles/*/gui_state.json
profiles/*/reports/

# takes of the GUI Record button (mic + output WAVs)
/recordings/
